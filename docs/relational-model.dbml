//https://dbdiagram.io/d.

Project ByteTech {
  database_type: 'MySQL'
  Note: '''ByteTech is the only retailer. MySQL 8.4+, InnoDB, UTC.
  All monetary values use DECIMAL(10,2) directly in RON, e.g. 12.00 or 12.99.
  This is a proposed data model; application features are not implemented yet.'''
}

Enum user_role {
  customer
  admin
}

Enum order_status {
  new
  paid
  shipped
  delivered
  cancelled
}

Enum payment_status {
  pending
  succeeded
  failed
  cancelled
}

Enum reservation_status {
  reserved
  consumed
  released
}

Table users {
  id "int unsigned" [pk, increment]
  email varchar(254) [not null, unique]
  password_hash varchar(255) [not null, note: 'Encoded bcrypt or Argon2 hash.']
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  role user_role [not null, default: 'customer']
  Note: 'A4, A9, A10: customer accounts and the separate administrator role.'
}

Table user_sessions {
  token_hash char(64) [pk, note: 'SHA-256 of a random opaque session token; raw token goes in an HttpOnly cookie.']
  user_id "int unsigned" [not null]
  csrf_token_hash char(64) [not null, note: 'Hash of the session-bound CSRF token for browser mutations.']
  expires_at datetime [not null]
  indexes {
    user_id
    expires_at
  }
  Note: 'A4, A10: revocable login sessions. Logout deletes the session, not the cart.'
}

Table user_addresses {
  id "int unsigned" [pk, increment]
  user_id "int unsigned" [not null]
  recipient_name varchar(200) [not null]
  phone varchar(32) [not null]
  address_line varchar(255) [not null, note: 'Street, number and apartment details.']
  city varchar(100) [not null]
  region varchar(100) [not null]
  postal_code varchar(20) [not null]
  indexes { user_id }
  Note: 'A4, A5: saved delivery addresses belonging to a customer.'
}

Table categories {
  id "int unsigned" [pk, increment]
  name varchar(100) [not null, unique]
  is_active boolean [not null, default: true]
  Note: 'A1, A9: category pages use the category ID. Deactivate categories to preserve historical references.'
}

Table products {
  id "int unsigned" [pk, increment]
  category_id "int unsigned" [not null]
  name varchar(200) [not null]
  description text [not null]
  price decimal(10,2) [not null, check: `price >= 0`, note: 'Price in RON.']
  stock_quantity "int unsigned" [not null, default: 0, note: 'On-hand stock; decreases only on confirmed payment.']
  is_active boolean [not null, default: true]
  indexes { (category_id, is_active, id) }
  Note: 'A1, A2, A7, A9: catalog, name search and stock. Products are identified by ID; deletion deactivates historical products.'
}

Table product_images {
  id "int unsigned" [pk, increment]
  product_id "int unsigned" [not null]
  url varchar(500) [not null, note: 'Public image URL/path produced by the future upload handler.']
  alt_text varchar(255) [not null]
  sort_order "smallint unsigned" [not null, default: 0]
  indexes { (product_id, sort_order) [unique] }
  Note: 'A1, A9: multiple ordered images per product. The first image is the catalog thumbnail.'
}

Table cart_items {
  user_id "int unsigned" [not null]
  product_id "int unsigned" [not null]
  quantity "int unsigned" [not null, check: `quantity > 0`]
  indexes {
    (user_id, product_id) [pk]
    product_id
  }
  Note: 'A3: one persistent cart per user, represented by its item rows. Calculate prices and totals from products on the server.'
}

Table shipping_methods {
  id "int unsigned" [pk, increment]
  name varchar(100) [not null, unique]
  cost decimal(10,2) [not null, check: `cost >= 0`, note: 'Delivery cost in RON.']
  is_active boolean [not null, default: true]
  Note: 'A5: seed at least two delivery methods with different costs.'
}

Table orders {
  id "int unsigned" [pk, increment]
  order_number varchar(40) [not null, unique]
  user_id "int unsigned" [not null]
  shipping_method_id "int unsigned" [not null]
  shipping_method_name varchar(100) [not null, note: 'Delivery method name at checkout.']
  status order_status [not null, default: 'new']
  subtotal decimal(10,2) [not null, check: `subtotal >= 0`]
  shipping_cost decimal(10,2) [not null, check: `shipping_cost >= 0`]
  total decimal(10,2) [not null, check: `total >= 0`]
  recipient_name varchar(200) [not null]
  phone varchar(32) [not null]
  address_line varchar(255) [not null]
  city varchar(100) [not null]
  region varchar(100) [not null]
  postal_code varchar(20) [not null]
  stock_deducted_at datetime [note: 'Set once when the confirmed payment decreases stock.']
  stock_restored_at datetime [note: 'Set once when cancellation restores previously deducted stock.']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  checks {
    `total = subtotal + shipping_cost` [name: 'chk_order_total']
    `stock_restored_at IS NULL OR stock_deducted_at IS NOT NULL` [name: 'chk_stock_restore']
  }
  indexes {
    (user_id, created_at)
    (status, created_at)
    shipping_method_id
  }
  Note: 'A5-A9: order number, date, totals, status and one delivery-address snapshot. Failed payment leaves status new (Unpaid).'
}

Table order_items {
  order_id "int unsigned" [not null]
  product_id "int unsigned" [not null]
  product_name varchar(200) [not null, note: 'Product name at checkout.']
  unit_price decimal(10,2) [not null, check: `unit_price >= 0`, note: 'Unit price in RON at checkout.']
  quantity "int unsigned" [not null, check: `quantity > 0`]
  indexes {
    (order_id, product_id) [pk]
    product_id
  }
  Note: 'A5, A8: immutable purchased-item snapshots. Line total = quantity * unit_price.'
}

Table payments {
  id "int unsigned" [pk, increment]
  order_id "int unsigned" [not null]
  stripe_checkout_session_id varchar(255) [unique]
  stripe_payment_intent_id varchar(255) [unique]
  idempotency_key varchar(100) [not null, unique, note: 'Reuse when retrying creation of the same Stripe payment attempt.']
  amount decimal(10,2) [not null, check: `amount >= 0`, note: 'Expected payment amount in RON.']
  status payment_status [not null, default: 'pending']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes { order_id }
  Note: 'A6: Stripe test payment attempts. The service must allow at most one successful payment per order. No card data is stored.'
}

Table payment_events {
  stripe_event_id varchar(255) [pk]
  payment_id "int unsigned" [not null]
  event_type varchar(100) [not null]
  processed_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes { payment_id }
  Note: 'A6, A7: processed, signature-verified webhook events only. Insert atomically with payment/order/stock changes; failed processing rolls back so Stripe can retry.'
}

Table stock_reservations {
  order_id "int unsigned" [not null]
  product_id "int unsigned" [not null]
  quantity "int unsigned" [not null, check: `quantity > 0`]
  status reservation_status [not null, default: 'reserved']
  expires_at datetime [not null, note: 'Cleanup deadline; confirm Stripe can no longer collect payment before releasing stock.']
  indexes {
    (order_id, product_id) [pk]
    (product_id, status)
    (status, expires_at)
  }
  Note: 'A7: available stock = on-hand stock minus reserved quantities. Reserve under product row locks; consume reservations and decrease on-hand stock only on confirmed payment.'
}

Ref: user_sessions.user_id > users.id [delete: cascade]
Ref: user_addresses.user_id > users.id [delete: cascade]
Ref: products.category_id > categories.id [delete: restrict]
Ref: product_images.product_id > products.id [delete: cascade]
Ref: cart_items.user_id > users.id [delete: cascade]
Ref: cart_items.product_id > products.id [delete: cascade]
Ref: orders.user_id > users.id [delete: restrict]
Ref: orders.shipping_method_id > shipping_methods.id [delete: restrict]
Ref: order_items.order_id > orders.id [delete: restrict]
Ref: order_items.product_id > products.id [delete: restrict]
Ref: payments.order_id > orders.id [delete: restrict]
Ref: payment_events.payment_id > payments.id [delete: restrict]
// One order item has zero or one reservation; the second side owns the FK.
Ref: order_items.(order_id, product_id) - stock_reservations.(order_id, product_id) [delete: restrict]

TableGroup Accounts {
  users
  user_sessions
  user_addresses
}

TableGroup Catalog {
  categories
  products
  product_images
}

TableGroup Shopping {
  cart_items
  shipping_methods
}

TableGroup OrdersAndPayments {
  orders
  order_items
  payments
  payment_events
  stock_reservations
}
