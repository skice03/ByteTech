      <TR><TD BGCOLOR="#FFFFFF"><B>UK</B></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC">email</TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT COLOR="#475569">varchar(254)</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFFFFF"><B> </B></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">password_hash</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT COLOR="#475569">varchar(255)</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFFFFF"><B> </B></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC">first_name</TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT COLOR="#475569">varchar(100)</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFFFFF"><B> </B></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">last_name</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT COLOR="#475569">varchar(100)</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFFFFF"><B> </B></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC">role</TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT COLOR="#475569">user_role</FONT></TD></TR>
    </TABLE>
  >];

  user_sessions [shape=plain, id="entity_user_sessions", label=<
