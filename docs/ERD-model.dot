  >];

  // Each relationship has a named diamond. Labels on each half-line
  // state the number of records at its table end. 0..N = zero or many.
  node [shape=diamond, style=filled, fillcolor="#F97316", color="#EA580C",
    fontcolor="white", fontsize=13, margin="0.15,0.10", penwidth=1.5];
  has_session [id="relationship_has_session", label="Has\nsession\n1:N"];
  users -- has_session [label="1"];
  has_session -- user_sessions [label="0..N"];

  saves_address [id="relationship_saves_address", label="Saves\naddress\n1:N"];
  users -- saves_address [label="1"];
  saves_address -- user_addresses [label="0..N"];

  categorizes [id="relationship_categorizes", label="Contains\nproduct\n1:N"];
  categories -- categorizes [label="1"];
  categorizes -- products [label="0..N"];

  has_image [id="relationship_has_image", label="Has\nimage\n1:N"];
  products -- has_image [label="1"];
  has_image -- product_images [label="1..N"];

  keeps_cart_item [id="relationship_keeps_cart_item", label="Keeps cart\nitem\n1:N"];
  users -- keeps_cart_item [label="1"];
  keeps_cart_item -- cart_items [label="0..N"];

  cart_references_product [id="relationship_cart_references_product", label="References\nproduct\n1:N"];
  products -- cart_references_product [label="1"];
  cart_references_product -- cart_items [label="0..N"];

  places_order [id="relationship_places_order", label="Places\norder\n1:N"];
  users -- places_order [label="1"];
  places_order -- orders [label="0..N"];

  uses_shipping [id="relationship_uses_shipping", label="Used for\ndelivery\n1:N"];
  shipping_methods -- uses_shipping [label="1"];
  uses_shipping -- orders [label="0..N"];

  contains_item [id="relationship_contains_item", label="Contains\nitem\n1:N"];
  orders -- contains_item [label="1"];
  contains_item -- order_items [label="1..N"];

  appears_in [id="relationship_appears_in", label="Appears\nin\n1:N"];
  products -- appears_in [label="1"];
  appears_in -- order_items [label="0..N"];

  has_payment [id="relationship_has_payment", label="Has payment\nattempt\n1:N"];
  orders -- has_payment [label="1"];
  has_payment -- payments [label="0..N"];

  has_event [id="relationship_has_event", label="Has processed\nevent\n1:N"];
  payments -- has_event [label="1"];
  has_event -- payment_events [label="0..N"];

  has_reservation [id="relationship_has_reservation", label="Has\nreservation\n1:1"];
  order_items -- has_reservation [label="1"];
  has_reservation -- stock_reservations [label="0..1"];
}
