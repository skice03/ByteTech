//https://dreampuf.github.io/GraphvizOnline/
// PK, FK and UK unique key
graph ByteTech_ERD {
  graph [rankdir=TB, bgcolor="white", pad=0.45, nodesep=0.65, ranksep=0.85,
    splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Arial",
    label="ByteTech - Entity Relationship Diagram\nTables, attributes, named relationships and cardinalities",
    labelloc=t, fontsize=24, fontcolor="#153B33"];
  node [fontname="Arial", fontsize=12, color="#475569"];
  edge [fontname="Arial", fontsize=14, color="#64748B", fontcolor="#0F172A", penwidth=1.5];

  users [shape=plain, id="entity_users", label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94A3B8">
      <TR><TD COLSPAN="3" BGCOLOR="#166534"><FONT COLOR="white" POINT-SIZE="16"><B>users</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#E2E8F0"><B>Key</B></TD><TD BGCOLOR="#E2E8F0" ALIGN="LEFT"><B>Attribute</B></TD><TD BGCOLOR="#E2E8F0" ALIGN="LEFT"><B>Type</B></TD></TR>
