{
  "name": "bytetech-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ByteTech Express and MySQL API foundation",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "db:migrate": "node --env-file-if-exists=../.env scripts/migrate.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=../.env --test test/integration/*.test.js"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "mysql2": "^3.24.6"
  }
}
